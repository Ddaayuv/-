# توكن البوت من @BotFather
BOT_TOKEN=123456:ABC-your-token

# معرّفات المالك/المطوّر مفصولة بفاصلة. هؤلاء فقط لديهم لوحة المطوّر.
OWNER_IDS=111111111

# اسم الأكاديمية الذي يظهر للمستخدم
ACADEMY_NAME=أكاديمية الأمن السيبراني

# قاعدة البيانات: اختر واحداً فقط.
# SQLite: ضع مساراً داخل Railway Volume دائم مثل /app/data/bot.db
DB_PATH=data/bot.db
# PostgreSQL (اختياري): ضع DATABASE_URL من Railway Postgres؛ عند ضبطه يتقدم على DB_PATH.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# الإعدادات الابتدائية لقناة واحدة؛ بعد التشغيل يمكن إدارة عدة قنوات من لوحة المطوّر.
CHANNEL_ID=
CHANNEL_LINK=
REQUIRE_MEMBERSHIP=false
ANNOUNCE=true

# النسخ الاحتياطي اليومي: Telegram ID المرسل إليه، والساعة حسب TIMEZONE.
# إذا بقي BACKUP_CHAT_ID فارغاً يتوقف النسخ التلقائي، لكن يبقى /backup متاحاً للمالك.
BACKUP_CHAT_ID=
BACKUP_HOUR=3

# إعدادات التشغيل والسجلات
LOG_LEVEL=INFO
TIMEZONE=Asia/Baghdad
BOT_VERSION=development

# إعدادات PostgreSQL الاختيارية لـ docker-compose --profile postgres
# POSTGRES_DB=steyat
# POSTGRES_USER=steyat
# POSTGRES_PASSWORD=ضع_كلمة_مرور_قوية


# مولّد الاختبارات يستخدم محللاً محلياً منظماً ولا يحتاج مفتاح API.
# يجب كتابة الإجابة الصحيحة صراحةً؛ البوت لا يخترع إجابات.

# الاختبارات الجماعية: لا يلزم إعداد بيئي إضافي.
# لكل مجموعة توقيت محفوظ في قاعدة البيانات (الافتراضي Asia/Baghdad)، ويُعدّل بالأمر /quiztimezone.

# Redis اختياري لتخزين FSM؛ إذا لم تضبطه يستخدم تخزين قاعدة البيانات.
REDIS_URL=
